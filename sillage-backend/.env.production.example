# Template para variables de entorno en producción
# NO COMMITEAR el archivo .env.production real
# Copiar este archivo a .env.production y llenar con valores reales

# Entorno
ENVIRONMENT=production

# Base de datos (Render lo proporciona automáticamente)
DATABASE_URL=postgresql://user:password@host:5432/sillage
REDIS_URL=redis://host:6379

# Seguridad (generar una clave secreta de 32+ caracteres)
SECRET_KEY=

# APIs externas
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# PayPal
PAYPAL_BUSINESS_EMAIL=
PAYPAL_URL=https://www.paypal.com/cgi-bin/webscr

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# URLs
FRONTEND_URL=https://app.tudominio.com
BACKEND_URL=https://api.tudominio.com

# CORS (separar con comas)
ALLOWED_ORIGINS=https://app.tudominio.com,https://tudominio.com
