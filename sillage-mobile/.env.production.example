# Template para variables de entorno en producción (Mobile/Web)
# NO COMMITEAR el archivo .env.production real
# Copiar este archivo a .env.production y llenar con valores reales

# API Backend
EXPO_PUBLIC_API_URL=https://api.tudominio.com/api/v1

# Google Maps (para location picker)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Entorno
EXPO_PUBLIC_ENVIRONMENT=production
